# Numera — environment variables
# Copy this file to .env.local and fill in real values before running

# Backend REST API base URL
NEXT_PUBLIC_API_BASE_URL=https://api.numera.nablix.com/v1

# WebSocket voice streaming endpoint
NEXT_PUBLIC_WS_URL=wss://api.numera.nablix.com/voice

# Tutor text-to-speech engine (see lib/tts.ts):
#   browser (default) — the browser voices the reply (Web Speech API), zero latency.
#   stream            — play OpenAI TTS streamed over the voice WS (tts_start/tts_chunk/
#                       tts_end); falls back to the browser voice if no audio arrives.
# Use 'stream' once the :8004 voice server emits the tts_* messages.
NEXT_PUBLIC_TTS_MODE=browser
